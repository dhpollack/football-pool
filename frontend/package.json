{
  "name": "frontend",
  "private": true,
  "version": "0.4.17",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:msw": "vite --mode msw",
    "generate": "orval --config orval.config.cjs",
    "build": "tsc --noEmit --project tsconfig.app.json && vite build",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "biome-migrate": "biome migrate",
    "preview": "vite preview",
    "tailwind-init": "tailwindcss init -p",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:chrome": "playwright test --project=chromium",
    "test:e2e:firefox": "playwright test --project=firefox",
    "test:e2e:webkit": "playwright test --project=webkit",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright test --reporter=html",
    "playwright:install": "playwright install",
    "playwright:install:chromium": "playwright install chromium chromium-headless-shell",
    "playwright:install:firefox": "playwright install firefox",
    "playwright:install:webkit": "playwright install webkit",
    "playwright:show-report": "playwright show-report",
    "msw:init": "msw init public/"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.102.8",
    "axios": "^1.20.0",
    "react": "^19.2.8",
    "react-auth-kit": "^4.0.2-alpha.11",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.63.0",
    "@tanstack/react-query-devtools": "^5.102.8",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "autoprefixer": "^10.5.5",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "orval": "^8.28.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
